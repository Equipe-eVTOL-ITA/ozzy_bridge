// =============================================================================
// secrets.h.example — copie para secrets.h e preencha.
// =============================================================================
//
//     cp include/secrets.h.example include/secrets.h
//
// `secrets.h` é ignorado pelo git. Senha de WiFi da equipe não entra em
// repositório, nem em repositório privado: ele vira público um dia, ou alguém
// dá acesso a mais alguém, e a senha continua lá no histórico.
// =============================================================================
#pragma once

#define OZZY_WIFI_SSID   "rede-da-equipe"
#define OZZY_WIFI_PASS   "senha-da-rede"

// IP do computador que roda o `MicroXRCEAgent`, na mesma rede.
// Descubra com `hostname -I` nesse computador.
//
// Fixe esse IP no roteador (DHCP reservation). Se ele mudar, o ESP32 fica
// tentando conectar num endereço que não existe mais, e o sintoma é um ESP32
// que pisca normal e um `ros2 topic list` vazio.
#define OZZY_AGENT_IP    "192.168.0.100"
#define OZZY_AGENT_PORT  8888
